# backend（后端原始文件）和 scripts（历史脚本）保留原始字节，避免换行转换改变内容摘要。
backend/*.py -text whitespace=cr-at-eol
scripts/*.py -text whitespace=cr-at-eol

# README（归档说明）、manifest（归档清单）、patch（停用补丁）和提取测试统一使用 LF（换行符）。
*.md text eol=lf
*.json text eol=lf
*.patch text eol=lf
tests/*.py text eol=lf

# patch（源码差异补丁）中的空白上下文标记必须原样保留。
*.patch -whitespace
