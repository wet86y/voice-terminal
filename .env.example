# 桌面界面的语音接口与实时通信地址由当前宿主提供，无浏览器环境变量覆盖。

# Windows Voice Server secrets (keep actual values in .env.local or the process environment)
VOICE_MODEL_DIR=D:\模型\voice-terminal
VOICE_SERVER_HOST=127.0.0.1
VOICE_SERVER_PORT=8765
ASR_WORKER_HOST=127.0.0.1
ASR_WORKER_PORT=8766
# Optional override; when host/port above are changed, the URL is rebuilt automatically.
# ASR_WORKER_URL=ws://127.0.0.1:8766/asr

# The MiniMax key is used by TTS and, when v02.web_search is enabled, by the
# optional MiniMax Token Plan web_search tool. No separate search key is used.
OPENCODE_GO_API_KEY=
DEEPSEEK_API_KEY=
# DeepSeek Responses / deepseek-flash is the default real-conversation backend.
# Optional temporary profile override. Prefer scripts/start.ps1 -LlmProvider.
# VOICE_LLM_PROVIDER=opencode_go
MINIMAX_API_KEY=
MINIMAX_API_HOST=https://api.minimaxi.com

VOICE_WAKE_ENABLED=false
VOICE_DEBUG_AUDIO_CAPTURE=false
# Full-fidelity LLM request/outcome audit is enabled by default. The JSONL
# contains complete system/user/assistant text, model output and reasoning.
# VOICE_LLM_CONTEXT_AUDIT=0

# Log files. VOICE_LOG_LEVEL defaults to INFO; the whole cache/logs directory
# keeps a total budget (MiB) and evicts the oldest rotated files above it.
# VOICE_LOG_LEVEL=DEBUG
# VOICE_LOG_BUDGET_MB=100
# VOICE_LOG_SWEEP_SECONDS=300
# VOICE_LOG_MIN_AGE_SECONDS=60
# VOICE_LOG_BUDGET_WATCHDOG=0
# Local TTS diagnostics: native staged timing (timing-perturbing) and an
# optional 120-character text preview in the local TTS log lines.
# VOICE_TTS_NATIVE_TRACE=1
# VOICE_TTS_LOG_TEXT=1
# VOICE_TTS_NATIVE_LOG_PUMP=0
