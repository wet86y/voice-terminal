{
  "name": "@voice-terminal/dsh-shadow-bridge",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "lib/plugin.js",
  "files": [
    "lib/index.js",
    "lib/index.js.map",
    "lib/protocol.js",
    "lib/protocol.js.map",
    "lib/plugin.js",
    "lib/plugin.js.map",
    "lib/settings.js",
    "lib/settings.js.map",
    "lib/settings-contract.js",
    "lib/settings-contract.js.map",
    "lib/client.js",
    "lib/client.js.map",
    "lib/generated-prompt.js",
    "lib/generated-prompt.d.ts",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": "./lib/plugin.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "node ../../../.runtime/dsh/source/node_modules/typescript/bin/tsc -p tsconfig.json && node ../../../.runtime/dsh/source/node_modules/typescript/bin/tsc -p tsconfig.client.json",
    "build": "npm run typecheck && node build.mjs",
    "test": "npm run typecheck && node build.mjs ../../../.runtime/dsh/bundles/voice-terminal-shadow-bridge-test && node --test test/context-merge.test.mjs test/session-settings.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-agent-loop": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-workspace": "*",
    "@deepseek-ai/schemastery": "*"
  }
}
