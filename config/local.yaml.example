# Copy this file to config/local.yaml and adjust only local, non-secret settings.
# API keys belong in .env.local or the process environment.

audio:
  input_device: "麦克风阵列 (适用于数字麦克风的英特尔® 智音技术)"
  output_device: "扬声器 (Realtek(R) Audio)"
  # AEC is enabled by default. When protection is unavailable raw VAD is
  # never allowed to cancel TTS.
  processing_enabled: true
  processing_required: false
  # pause_recover | stop_and_listen | continue_without_barge_in
  aec_failure_policy: pause_recover
  echo_cancellation: true
  noise_suppression: true
  device_latency_ms: 0

wake:
  enabled: false
  keyword: "hei claw"
  threshold: 0.25

asr:
  device: auto

llm:
  provider: deepseek
  base_url: https://api.deepseek.com
  model: deepseek-flash
  api_key_env: DEEPSEEK_API_KEY
  # Debug-only switch without editing this file:
  # $env:VOICE_LLM_PROVIDER = "opencode_go"
  # Active test transport. chat_completions is the hidden rollback value.
  transport: responses
  reasoning_mode: balanced
  # Keep disabled during the pure protocol migration baseline.
  thinking: disabled
  thinking_action_enabled: false
  protocol_recovery_limit: 1
  transport_retry_limit: 2

# The session-scoped single Shadow Agent is enabled by default. Its debug wake
# endpoint remains off unless this machine is intentionally used for it.
shadow_agent:
  enabled: true
  debug_websocket_enabled: false
  max_context_tokens: 524288
  compaction_threshold_ratio: 0.80
  provider:
    timeout_ms: 15000
    transport_retry_limit: 2
  status_observer:
    enabled: true
    every_committed_steps: 5
    reasoning_effort: none
    max_output_tokens: 512
    timeout_ms: 10000
  tools:
    files_enabled: true
    allowed_roots: [docs]
    web_search:
      enabled: true
      base_url: https://api.minimaxi.com
      api_key_env: MINIMAX_API_KEY
      timeout_ms: 5000

tts:
  model: speech-2.8-hd
  output_format: pcm
