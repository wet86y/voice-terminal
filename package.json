{
  "name": "voice-terminal",
  "version": "0.7.0",
  "private": true,
  "description": "本地模块化实时语音终端 v0.7",
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @voice-terminal/web",
    "dev:ui": "npm run dev:ui --workspace @voice-terminal/web",
    "desktop:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-desktop.ps1 -Dev",
    "desktop:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-desktop.ps1",
    "desktop:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-desktop.ps1",
    "build": "npm run build --workspace @voice-terminal/web",
    "typecheck": "npm run typecheck --workspace @voice-terminal/web",
    "test": "npm run test --workspace @voice-terminal/web",
    "preview": "npm run preview --workspace @voice-terminal/web"
  },
  "engines": {
    "node": ">=20"
  }
}
